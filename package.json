{
  "name": "last-rune",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "The Last Rune — a gem-circuit puzzle game for the browser (WebGPU). First game on the ThunderClap engine (@thunderclap-engine/engine from npm).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node scripts/desktop/e2e.mjs",
    "desktop:dev": "thunderclap-desktop dev",
    "desktop:build": "thunderclap-desktop package",
    "desktop:icon": "node scripts/desktop/icon.mjs",
    "baseline": "playwright test -c scripts/baseline/playwright.config.ts",
    "audio:check": "node scripts/audio-check.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "puzzle": "tsx tools/puzzle.ts",
    "social": "playwright test -c scripts/cover/playwright.config.ts"
  },
  "dependencies": {
    "@thunderclap-engine/engine": "^1.3.0",
    "@thunderclap-engine/host-electron": "^0.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "thunderclap": {
    "desktop": {
      "productName": "The Last Rune",
      "appId": "com.thunderclap.lastrune",
      "icon": "build/desktop/icon.png",
      "prePackage": "node scripts/desktop/icon.mjs"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
