{
  "name": "last-rune",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The Last Rune \u2014 a gem-circuit puzzle game for the browser (WebGPU). First game on the ThunderClap engine.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:engine": "pnpm --filter @thunderclap/engine test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:engine": "pnpm --filter @thunderclap/engine test:e2e",
    "package:itch": "node scripts/package-itch.mjs",
    "itch:sim": "node scripts/itch-sim/serve.mjs",
    "audio:check": "node scripts/audio-check.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "pnpm check:engine && pnpm check:game",
    "check:engine": "pnpm --filter @thunderclap/engine check",
    "check:game": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "puzzle": "tsx tools/puzzle.ts"
  },
  "dependencies": {
    "@thunderclap/engine": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.74",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  }
}
